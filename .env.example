# ─────────────────────────────────────────────────────────────────────────────
# Chandelier — configuration. Copier en .env :  cp .env.example .env
# Aucune valeur sensible ici. Avec Docker Compose, les secrets manquants
# (mot de passe PostgreSQL, secret de session, mot de passe admin initial)
# sont GÉNÉRÉS ALÉATOIREMENT au premier démarrage dans le volume
# "chandelier_secrets" : aucun mot de passe par défaut n'existe.
# ─────────────────────────────────────────────────────────────────────────────

# production | development | test
NODE_ENV=production
# URL publique par laquelle les utilisateurs accèdent à l'application
APP_URL=http://localhost:8080
LOG_LEVEL=info

# ── Exposition réseau du service web ────────────────────────────────────────
# 127.0.0.1 = accessible uniquement depuis ce Mac (défaut, recommandé).
# 0.0.0.0   = accessible depuis le réseau local (REMOTE_ACCESS_MODE=lan, voir docs/REMOTE_ACCESS.md).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# disabled | lan | tailscale | cloudflare — jamais activé implicitement
REMOTE_ACCESS_MODE=disabled

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=chandelier
POSTGRES_USER=chandelier
# Laisser vide en Docker : un mot de passe aléatoire est généré au premier démarrage.
# Si vous le fixez : caractères [A-Za-z0-9] uniquement, 32 caractères minimum.
POSTGRES_PASSWORD=

# Hors Docker uniquement (développement local / CI). En Docker, l'URL est construite automatiquement.
# DATABASE_URL=postgresql://chandelier:<mot-de-passe>@localhost:5432/chandelier
DATABASE_URL=
# Base dédiée aux tests d'intégration (elle est RÉINITIALISÉE à chaque exécution des tests)
DATABASE_URL_TEST=

# ── Sessions ─────────────────────────────────────────────────────────────────
# Laisser vide en Docker (généré). Hors Docker : 64 caractères hexadécimaux minimum (openssl rand -hex 32).
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10
# auto = Secure si APP_URL est en https
COOKIE_SECURE=auto

# ── Authentification ─────────────────────────────────────────────────────────
# local | oidc  (oidc = Microsoft Entra ID, non implémenté à ce stade)
AUTH_MODE=local
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# Compte administrateur initial, créé une seule fois si aucun SUPER_ADMIN n'existe.
# Le mot de passe est généré aléatoirement et doit être changé à la première connexion :
#   docker compose exec api cat /run/chandelier-secrets/initial_admin_password
BOOTSTRAP_ADMIN_EMAIL=admin@chandelier.local
BOOTSTRAP_ADMIN_NAME="Administrateur Chandelier"

# Charger le jeu de démonstration FICTIF (SIA-DEMO-*) au démarrage : true | false
SEED_DEMO=false

# ── Assistant IA (désactivé par défaut) ──────────────────────────────────────
# disabled | anthropic
LLM_PROVIDER=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Documents ────────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=25

# ── Cloudflare Tunnel (facultatif, profil "cloudflare") ──────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
